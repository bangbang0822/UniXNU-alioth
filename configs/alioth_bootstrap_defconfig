# alioth_bootstrap_defconfig -- the first pass of a cold build.
#
# It exists only to produce one prelinked kernel, which the archive builders that bind
# against an "original candidate" then read as their baseline. On a cold tree those
# builders stop with
#
#   No reference candidate available
#
# because scripts/build-gop-legacy-display.py and build-sheng-hid-input.py read symbol
# addresses out of a previously prelinked kernel and write them into original-bindings.S.
#
# Unlike configs/nabu_bootstrap_defconfig in unixnu-nabu, this pass does NOT turn the board
# archive list off. Measured 2026-11-13 on a macOS runner: with CONFIG_XNU_BUILD_ARCHIVES
# unset the archives that produce corecrypto never run, and build-xnu-4k-baseline.sh:826
# then stops at `test -f "$CRYPTO_ARCHIVE"`. The list has to stay on; the two recipes that
# need a candidate handle the cold tree themselves, with the same no-op fallback that
# scripts/build-platform-power.py already uses for its bridge.
#
# What this configuration does change is the two archives no recipe here produces from a
# cold tree. Both are inputs of the desktop profile rather than of this one.

# The three functions the XNU patches call into the legacy display driver are defined by the
# archive the display recipe builds. That recipe needs a reference candidate, which is what this
# pass is meant to produce, so on a cold tree nothing defines them and the link fails with
#   _native_legacy_count_exec / _native_legacy_note_exit / _native_legacy_paint_userspace_band
# build-xnu-4k-baseline.sh:823 appends this value to the link line, so a stub object carrying
# the three bodies resolves them without touching the archive chain.
# The object must be a Mach-O arm64 object and must be passed as an object rather than as an
# archive member, because that path appends the value without -Wl,-force_load.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/bootstrap-stubs/stubs.o"

# Produced by build-cpu-desktop-kernel.py from a mounted IPSW volume; a cold board tree has
# neither. The plain archive that build-storage-bindings.py writes is what is available.
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/virtio-mmio-block/libVirtioMmioBlock.a"

# Same reason: the probe force-loads libVerifiedRootProbe.a from a bundle this tree cannot
# make. The policy is unchanged in the shipping configuration; only this intermediate pass
# links without it.
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set

# This configuration does NOT produce a usable image. It is a build intermediate.
